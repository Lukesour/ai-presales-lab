{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Presales Solution Response",
  "$id": "https://example.com/ai-presales-lab/dify/output-schema-v2.json",
  "type": "object",
  "required": [
    "case_id",
    "executive_summary",
    "requirements",
    "recommendation",
    "architecture",
    "implementation_steps",
    "risks",
    "clarifying_questions",
    "evidence",
    "poc_plan",
    "model_strategy",
    "assumptions",
    "review_status"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "executive_summary": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "priority", "source"],
        "properties": {
          "name": {"type": "string"},
          "value": {"type": "string"},
          "priority": {"enum": ["must", "should", "nice_to_have"]},
          "source": {"type": "string"}
        }
      }
    },
    "recommendation": {"type": "array", "items": {"type": "string"}},
    "architecture": {"type": "array", "items": {"type": "string"}},
    "implementation_steps": {"type": "array", "items": {"type": "string"}},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "description", "severity", "action"],
        "properties": {
          "category": {"type": "string"},
          "description": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high"]},
          "action": {"type": "string"}
        }
      }
    },
    "clarifying_questions": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "title", "excerpt", "source_path", "relevance"],
        "properties": {
          "evidence_id": {"type": "string"},
          "title": {"type": "string"},
          "excerpt": {"type": "string"},
          "source_path": {"type": "string"},
          "relevance": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "poc_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "objective", "activities", "deliverables", "exit_criteria"],
        "properties": {
          "phase": {"type": "string"},
          "objective": {"type": "string"},
          "activities": {"type": "array", "items": {"type": "string"}},
          "deliverables": {"type": "array", "items": {"type": "string"}},
          "exit_criteria": {"type": "string"}
        }
      }
    },
    "model_strategy": {
      "type": "object",
      "required": [
        "primary_serving_path",
        "retrieval_strategy",
        "fine_tuning_strategy",
        "validation_before_commitment"
      ],
      "properties": {
        "primary_serving_path": {"type": "string"},
        "fallback_serving_path": {"type": "string"},
        "retrieval_strategy": {"type": "string"},
        "fine_tuning_strategy": {"type": "string"},
        "quantization_strategy": {"type": "string"},
        "serving_reason": {"type": "string"},
        "decision_inputs": {"type": "object"},
        "validation_before_commitment": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "model_name": {"type": "string"},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "usage": {"type": "object"},
    "run_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "review_status": {"enum": ["not_required", "pending", "approved", "rejected"]}
  }
}
